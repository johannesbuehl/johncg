{
	"name": "johncg",
	"version": "0.9.0-rc.1",
	"license": "MIT",
	"author": "Simon Ziegler <simon.ziegler.1998+github@pm.me>",
	"bin": "out/main.js",
	"main": "server/src/main.ts",
	"repository": {
		"url": "https://github.com/johannesbuehl/johncg",
		"type": "git"
	},
	"scripts": {
		"lint": "eslint .",
		"format-check": "prettier --check src/",
		"format-write": "prettier --write src/",
		"release": "run-s lint format-check release-build",
		"release-build": "node build/build-release.mjs && node build/release.js",
		"server-build": "node build/server.mjs release",
		"server-debug": "node build/server.mjs debug",
		"templates-dev": "vite -c src/templates/vite.config.ts",
		"templates-build": "run-p templates-type-check \"templates-build-only {@}\" --",
		"templates-preview": "vite -c src/templates/vite.config.ts preview",
		"templates-build-only": "vite -c src/templates/vite.config.ts build",
		"templates-type-check": "vue-tsc --noEmit -p src/templates/tsconfig.json",
		"client-dev": "vite -c src/client/vite.config.ts",
		"client-build": "run-p client-type-check \"client-build-only {@}\" --",
		"client-preview": "vite -c src/client/vite.config.ts preview",
		"client-build-only": "vite -c src/client/vite.config.ts build",
		"client-type-check": "vue-tsc --noEmit -p src/client/tsconfig.json",
		"prepare": "husky"
	},
	"dependencies": {
		"@babel/types": "^7.28.5",
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@fortawesome/fontawesome-svg-core": "^6.7.2",
		"@fortawesome/free-brands-svg-icons": "^6.7.2",
		"@fortawesome/free-regular-svg-icons": "^6.7.2",
		"@fortawesome/free-solid-svg-icons": "^6.7.2",
		"@fortawesome/vue-fontawesome": "^3.1.2",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"casparcg-connection": "6.3.0-nightly-master-20240412-065100-23103b26.0",
		"globals": "^16.5.0",
		"iconv-lite": "^0.6.3",
		"log4js": "^6.9.1",
		"mime-types": "^2.1.35",
		"optional": "^0.1.4",
		"pdf-parse": "^2.4.5",
		"sharp": "^0.34.5",
		"tmp": "^0.2.5",
		"typescript-eslint": "^8.46.4",
		"vue": "^3.5.24",
		"vue-draggable-next": "^2.3.0",
		"vue3-ts-jsoneditor": "^2.11.4",
		"vuefinder": "^2.7.1",
		"ws": "^8.18.3",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.39.1",
		"@tsconfig/node20": "^20.1.6",
		"@types/archiver": "^6.0.4",
		"@types/mime-types": "^2.1.4",
		"@types/node": "^20.19.25",
		"@types/tar": "^6.1.13",
		"@types/tmp": "^0.2.6",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.46.4",
		"@typescript-eslint/parser": "^8.46.4",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vue/eslint-config-prettier": "^8.0.0",
		"@vue/eslint-config-typescript": "^14.6.0",
		"@vue/tsconfig": "^0.5.1",
		"@weichwarenprojekt/license-reporter": "^1.1.0",
		"archiver": "^7.0.1",
		"esbuild": "^0.27.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-jsdoc": "^50.8.0",
		"eslint-plugin-vue": "^9.33.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^6.2.6",
		"postject": "1.0.0-alpha.6",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vue-tsc": "^2.2.12"
	},
	"pnpm": {
		"supportedArchitectures": {
			"os": [
				"current"
			],
			"cpu": [
				"x64"
			]
		}
	}
}
